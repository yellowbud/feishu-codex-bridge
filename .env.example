# Feishu/Lark self-built app credentials.
# Create an app in Feishu Open Platform, enable Bot and Event Subscription,
# then choose long-connection mode. No public callback URL is needed.
FEISHU_APP_ID=cli_a...
FEISHU_APP_SECRET=...

# Optional. Keep empty unless your event subscription enables them.
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# Command behavior.
FEISHU_COMMAND_PREFIX=/codex
# 0 = DM and authorized groups can send natural language directly.
FEISHU_REQUIRE_PREFIX=0
# Runtime access gate inspired by Claude IM channel skills. Existing
# FEISHU_ALLOWED_CHAT_IDS remains an outer compatibility allowlist.
FEISHU_ACCESS_ENABLED=1
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_MIRROR=0
FEISHU_MEMORY_ENABLED=1
# explicit = default every message is a new task; only "继续/接着/基于上文" carries context.
# always = old behavior: every task receives chat history.
FEISHU_MEMORY_MODE=explicit
FEISHU_MEMORY_MAX_TURNS=200
FEISHU_MEMORY_CONTEXT_TURNS=3
FEISHU_MEMORY_MAX_CHARS=240000
# 1 = each Feishu chat/thread resumes its own native Codex session; /new starts a fresh one.
FEISHU_CODEX_SESSIONS_ENABLED=1
# /new chat creates new project groups. Use thread for topic-style groups, chat for normal groups.
FEISHU_NEW_CHAT_GROUP_MESSAGE_TYPE=thread
# 1 = if Codex final reply references local image/file paths, upload them to Feishu.
FEISHU_OUTBOUND_MEDIA_ENABLED=1
# Optional extra allowed roots for outbound files, comma-separated. Current workspace, CODEX_CWD, data/, and /private/tmp are already allowed.
FEISHU_OUTBOUND_MEDIA_DIRS=
# Optional. When Codex outputs feishu-doc blocks, create Feishu Docs for long specs/docs.
# Leave folder token empty to create in the app/user default location.
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_DOC_BASE_URL=https://www.feishu.cn/docx
# Add one of these reactions to any message to forward it to Codex.
# If your tenant reports a different emoji_type, check logs/bridge.log and add it here.
FEISHU_CODEX_REACTION_EMOJIS=RobotFace,robot_face,ROBOT_FACE

# Codex execution.
CODEX_CWD=/Users/macmini
CODEX_BIN=codex
CODEX_MODEL=gpt-5.2
CODEX_EXTRA_ARGS=--skip-git-repo-check --dangerously-bypass-approvals-and-sandbox
CODEX_TIMEOUT_MS=1800000
MAX_CONCURRENT_TASKS=1

# Network. Uses your local proxy by default.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
ALL_PROXY=socks5h://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1
